# --- required in production ---
ENV=prod
PROVIDER=meta
MODEL_API_KEY=            # Meta Model API key (dev.meta.ai). Never commit.
JWT_SECRET=               # >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+asyncpg://milo:CHANGE_ME@db:5432/milo
KEY_ENC_SECRET=         # >= 32 random chars; encrypts family BYOK keys at rest. Never commit. Losing it means stored family keys cannot be decrypted (families re-enter them).
# --- Meta models (standard IDs only; '-contributor' IDs train on your data and are refused) ---
SPARK_MODEL=muse-spark-1.3
VOICE_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0
META_BASE_URL=https://api.meta.ai/v1
META_ASR_URL=wss://api.meta.ai/v1/asr/realtime
# --- protection ---
RATE_PER_MIN=30
RATE_PER_DAY=1500
DAILY_BUDGET_USD=20
MONTHLY_BUDGET_USD=100  # UTC-month cap on shared-key vendor spend (family keys spend the family's quota, never this)
# --- Milo-hosted open-weight model (milo-models app; empty = suite reasoning) ---
MODAL_MODELS_URL=       # e.g. https://<workspace>--milo-models-serve.us-east.modal.run
MODAL_MODELS_KEY=       # same value as VLLM_API_KEY in the milo-models secret. Never commit.
MODAL_MODEL=Qwen/Qwen3-4B-Instruct-2507
REASONING_PROVIDER=     # "" = follow PROVIDER suite; "modal" = hosted vLLM for text caps
MODAL_FALLBACK=true     # staging sets false so hosted outages fail loudly instead of testing the suite
# --- spend ledger (auto: postgres when DATABASE_URL set, else Modal Dict when named, else ephemeral memory) ---
SPEND_BACKEND=auto
SPEND_DICT_NAME=milo-spend
EPHEMERAL_DAY_USD=5     # ceilings that ALWAYS bind the memory ledger (conservative by design)
EPHEMERAL_MONTH_USD=20
BRAIN_MODE=json           # json | lines (fallback if streaming + json_schema do not combine)
ATTESTATION_MODE=off      # off | enforce (enforce refuses to start until a verifier is wired, see docs/LAUNCH_CHECKLIST.md)

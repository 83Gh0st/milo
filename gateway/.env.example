# --- required in production ---
ENV=prod
PROVIDER=meta
MODEL_API_KEY=            # Meta Model API key (dev.meta.ai). Never commit.
JWT_SECRET=               # >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+asyncpg://milo:CHANGE_ME@db:5432/milo
KEY_ENC_SECRET=         # >= 32 random chars; encrypts family BYOK keys at rest. Never commit. Losing it means stored family keys cannot be decrypted (families re-enter them).
# --- Meta models (standard IDs only; '-contributor' IDs train on your data and are refused) ---
SPARK_MODEL=muse-spark-1.3
VOICE_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0
META_BASE_URL=https://api.meta.ai/v1
META_ASR_URL=wss://api.meta.ai/v1/asr/realtime
# --- protection ---
RATE_PER_MIN=30
RATE_PER_DAY=1500
DAILY_BUDGET_USD=20
BRAIN_MODE=json           # json | lines (fallback if streaming + json_schema do not combine)
ATTESTATION_MODE=off      # off | enforce (enforce refuses to start until a verifier is wired, see docs/LAUNCH_CHECKLIST.md)
